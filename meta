}

local function normalizeEnabledSoundPreset(preset)
    if preset == "Classic" or preset == "UwU Girl" then
        return "Classic / Anime Girl"
    end
    if AUTO_PARRY_ENABLED_SOUNDS[preset] then
        return preset
    end
    return "Classic / Anime Girl"
end
getgenv().AutoParry.SoundOnPreset = normalizeEnabledSoundPreset(getgenv().AutoParry.SoundOnPreset)

function __VelocityFns.playAutoParryEnabledCue(preview)
    local config = getgenv().AutoParry
    if config.SoundQueue == false and not preview then return false end
    local preset = normalizeEnabledSoundPreset(config.SoundOnPreset)
    local soundId = AUTO_PARRY_ENABLED_SOUNDS[preset]
    if not soundId then return false end

    if not autoParrySound then
        autoParrySound = Instance.new("Sound")
        autoParrySound.Name = "AutoParryEnabledSound"
        autoParrySound.Looped = false
        autoParrySound.Parent = game:GetService("SoundService")
    end

    local ok = pcall(function()
        autoParrySound:Stop()
        autoParrySound.Volume = clamp(tonumber(config.SoundVolume) or 0.9, 0, 2)
        autoParrySound.SoundId = soundId
        autoParrySound:Play()
    end)
    return ok
end

function __VelocityFns.setAutoParryEnabled(value)
    local enabled = value == true
    getgenv().AutoParry.Enabled = enabled
    -- A disabled parry must not continue an already queued reaction.
    if not enabled and __VelocityFns.cancelAutoParryReaction then
        __VelocityFns.cancelAutoParryReaction(true)
    end
    if lastAutoParrySoundState == enabled then
        return
    end
    lastAutoParrySoundState = enabled

    if enabled then
        __VelocityFns.playAutoParryEnabledCue()
    end
end

