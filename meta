function __VelocityFns.getForceJumpKey(config)
    local key = config and config.Key
    if typeof(key) == "EnumItem" then
        return key
    end
    if type(key) == "string" then
        return Enum.KeyCode[key] or Enum.KeyCode.C
    end
    return Enum.KeyCode.C
end

