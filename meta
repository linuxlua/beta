local function clamp(value, minValue, maxValue)
    return math.min(math.max(value, minValue), maxValue)
end

local function safeDisconnect(signal)
    if signal then
        pcall(function()
            signal:Disconnect()
        end)
    end
end

local function safeDestroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

