-- Local visual cursor ownership only: does not report or change platform.
function __VelocityFns.applyCursor()
    local config = getgenv().Cursor
    local controller = __VelocityFns.getPlatformSpoofValue
        and __VelocityFns.getPlatformSpoofValue() == "Controller"
    local enabled = config.Enabled == true and controller
    consoleCursorActive = enabled

    if enabled then
        ensureConsoleDot()
        updateConsoleDotPosition()
        if consoleDotGui and not consoleDotGui.Enabled then
            consoleDotGui.Enabled = true
        end
        if previousMouseIconEnabled == nil then
            previousMouseIconEnabled = UserInputService.MouseIconEnabled
        end
        if UserInputService.MouseIconEnabled then
            UserInputService.MouseIconEnabled = false
        end
    else
        if consoleDotGui then consoleDotGui.Enabled = false end
        if previousMouseIconEnabled ~= nil then
            UserInputService.MouseIconEnabled = previousMouseIconEnabled
            previousMouseIconEnabled = nil
        end
    end

    if enabled and config.Position == "Centered" then
        if not config.MouseBehaviorLocked then
            config.PreviousMouseBehavior = UserInputService.MouseBehavior
            config.MouseBehaviorLocked = true
        end
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    elseif config.MouseBehaviorLocked then
        UserInputService.MouseBehavior = config.PreviousMouseBehavior or Enum.MouseBehavior.Default
        config.PreviousMouseBehavior = nil
        config.MouseBehaviorLocked = false
    end
end

