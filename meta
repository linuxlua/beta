local platformResyncActive = true
-- Respawn can reset the server's platform value after CharacterAdded fires.
-- Use spaced retries rather than a high-frequency RemoteEvent loop.
function __VelocityFns.hookPlatformOnCharacter(character)
    if not character then return end
    __VelocityFns.forcePlatformSpoofBurst()
    for _, delaySeconds in ipairs({ 0.4, 1.5, 3.0 }) do
        task.delay(delaySeconds, function()
            if platformResyncActive and LocalPlayer.Character == character then
                __VelocityFns.syncPlatformRemote(true, false)
            end
        end)
    end
end

