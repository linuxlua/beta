local trackedLocalSkillLabels = {}
local localSkillGuiConnections = {}
local trackedPlayerGui

function __VelocityFns.getLocalSkillSlot(label)
    local slot = label.Text:match("^%s*([1-4])%s*$")
    return slot
end

function __VelocityFns.getLocalAction(label)
    local text = label.Text:match("^%s*(.-)%s*$")
    for action in pairs(ACTION_TO_KEY) do
        if text:lower() == action:lower() then
            return action
        end
    end
end

function __VelocityFns.isLeaderboardLabel(label)
    local ancestor = label
    while ancestor and ancestor ~= trackedPlayerGui do
        local name = ancestor.Name:lower()
        if name:find("leaderboard", 1, true)
            or name:find("playerlist", 1, true)
            or name:find("scoreboard", 1, true)
            or name:find("leader", 1, true) then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

function __VelocityFns.findNearbyActionImage(label)
    local labelCenter = label.AbsolutePosition + label.AbsoluteSize / 2
    local bestImage
    local bestDistance = math.huge
    local ancestor = label.Parent

    for _ = 1, 4 do
        if not ancestor or ancestor == trackedPlayerGui then
            break
        end

        for _, child in ipairs(ancestor:GetChildren()) do
            if (child:IsA("ImageLabel") or child:IsA("ImageButton"))
                and child.Name ~= "VelocityControllerIcon"
                and child.Visible
                and child.AbsoluteSize.X > 8
                and child.AbsoluteSize.Y > 8 then
                local imageCenter = child.AbsolutePosition + child.AbsoluteSize / 2
                local offset = imageCenter - labelCenter
                local distance = offset.X * offset.X + offset.Y * offset.Y
                if distance < bestDistance then
                    bestDistance = distance
                    bestImage = child
                end
            end
        end
        ancestor = ancestor.Parent
    end

    if bestDistance <= 180 * 180 then
        return bestImage
    end
end

local originalActionImages = {}

function __VelocityFns.updateLocalActionIcon(tracked, action)
    local image = tracked.ActionImage
    if not image or not image.Parent then
        image = __VelocityFns.findNearbyActionImage(tracked.Label)
        tracked.ActionImage = image
    end
    if not image then
        return
    end

    if __VelocityFns.isControllerSpoofActive() then
        if originalActionImages[image] == nil then
            originalActionImages[image] = image.Image
        end
        local desiredImage = __VelocityFns.getControllerIcon(ACTION_TO_KEY[action])
        if desiredImage and image.Image ~= desiredImage then
            image.Image = desiredImage
        end
    else
        local originalImage = originalActionImages[image]
        if originalImage ~= nil then
            image.Image = originalImage
            originalActionImages[image] = nil
        end
    end
end

function __VelocityFns.isLocalSkillSlotLabel(label)
    local ancestor = label
    while ancestor and ancestor ~= trackedPlayerGui do
        local name = ancestor.Name:lower()
        if name:find("leaderboard", 1, true)
            or name:find("playerlist", 1, true)
            or name:find("scoreboard", 1, true)
            or name:find("leader", 1, true) then
            return false
        end

        if name:find("skill", 1, true)
            or name:find("move", 1, true)
            or name:find("hotbar", 1, true)
            or name:find("ability", 1, true) then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

function __VelocityFns.setLocalSkillSlotIcon(label, slot, tracked)
    if __VelocityFns.isControllerSpoofActive() then
        local icon = tracked.Icon
        if not icon or not icon.Parent then
            icon = Instance.new("ImageLabel")
            icon.Name = "VelocityControllerIcon"
            icon.BackgroundTransparency = 1
            icon.ScaleType = Enum.ScaleType.Fit
            icon.Parent = label
            tracked.Icon = icon
        end

        icon.Size = UDim2.fromScale(1.3, 1.3)
        icon.Position = UDim2.fromScale(-0.15, -0.15)
        icon.AnchorPoint = Vector2.zero
        icon.ZIndex = label.ZIndex
        icon.Image = __VelocityFns.getControllerIcon(slot)
        icon.Visible = true
        label.TextTransparency = 1
        label.TextStrokeTransparency = 1
    else
        if tracked.Icon then
            tracked.Icon.Visible = false
        end
        label.TextTransparency = tracked.TextTransparency
        label.TextStrokeTransparency = tracked.TextStrokeTransparency
    end
end

function __VelocityFns.updateLocalSkillLabel(label, tracked)
    local action = __VelocityFns.getLocalAction(label)
    if action then
        if tracked.Icon then
            tracked.Icon.Visible = false
        end
        label.TextTransparency = tracked.TextTransparency
        label.TextStrokeTransparency = tracked.TextStrokeTransparency
        tracked.Action = action
        __VelocityFns.updateLocalActionIcon(tracked, action)
        return
    end

    local slot = __VelocityFns.getLocalSkillSlot(label)
    if slot and __VelocityFns.isLocalSkillSlotLabel(label) then
        tracked.Slot = slot
        __VelocityFns.setLocalSkillSlotIcon(label, slot, tracked)
        return
    end

    if tracked.ActionImage then
        local originalImage = originalActionImages[tracked.ActionImage]
        if originalImage ~= nil then
            tracked.ActionImage.Image = originalImage
            originalActionImages[tracked.ActionImage] = nil
        end
        tracked.ActionImage = nil
        tracked.Action = nil
    end

    if tracked.Icon then
        tracked.Icon.Visible = false
    end
    label.TextTransparency = tracked.TextTransparency
    label.TextStrokeTransparency = tracked.TextStrokeTransparency
end

function __VelocityFns.trackLocalSkillLabel(label)
    if trackedLocalSkillLabels[label] or not (label:IsA("TextLabel") or label:IsA("TextButton")) then
        return
    end

    local action = __VelocityFns.getLocalAction(label)
    local slot = __VelocityFns.getLocalSkillSlot(label)
    if __VelocityFns.isLeaderboardLabel(label) or (not action and (not slot or not __VelocityFns.isLocalSkillSlotLabel(label))) then
        return
    end

    local tracked = {
        Label = label,
        Action = action,
        Slot = slot,
        TextTransparency = label.TextTransparency,
        TextStrokeTransparency = label.TextStrokeTransparency,
    }
    trackedLocalSkillLabels[label] = tracked
    tracked.Connection = label:GetPropertyChangedSignal("Text"):Connect(function()
        __VelocityFns.updateLocalSkillLabel(label, tracked)
    end)
    __VelocityFns.updateLocalSkillLabel(label, tracked)
end

function __VelocityFns.updateLocalSkillSlotIcons()
    for label, tracked in pairs(trackedLocalSkillLabels) do
        __VelocityFns.updateLocalSkillLabel(label, tracked)
    end
end

local actionIconRefreshPending = false
function __VelocityFns.scheduleLocalActionIconRefresh()
    if actionIconRefreshPending or not __VelocityFns.isControllerSpoofActive() then
        return
    end
    actionIconRefreshPending = true
    local function flush()
        actionIconRefreshPending = false
        if not trackedPlayerGui or not trackedPlayerGui.Parent then return end
        for _, tracked in pairs(trackedLocalSkillLabels) do
            if tracked.Action and tracked.Label and tracked.Label.Parent then
                __VelocityFns.updateLocalActionIcon(tracked, tracked.Action)
            end
        end
    end
    if getgenv().Performance.StabilityMode then
        task.delay(0.25, flush)
    else
        task.defer(flush)
    end
end

function __VelocityFns.trackLocalPlayerGui(playerGui)
    if trackedPlayerGui == playerGui then
        return
    end

    for _, connection in ipairs(localSkillGuiConnections) do
        safeDisconnect(connection)
    end
    table.clear(localSkillGuiConnections)
    for label, tracked in pairs(trackedLocalSkillLabels) do
        safeDisconnect(tracked.Connection)
        trackedLocalSkillLabels[label] = nil
    end

    trackedPlayerGui = playerGui
    if not playerGui then
        return
    end

    for _, descendant in ipairs(playerGui:GetDescendants()) do
        __VelocityFns.trackLocalSkillLabel(descendant)
    end
    table.insert(localSkillGuiConnections, playerGui.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            task.defer(__VelocityFns.trackLocalSkillLabel, descendant)
        elseif descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
            __VelocityFns.scheduleLocalActionIconRefresh()
        end
    end))
    table.insert(localSkillGuiConnections, playerGui.DescendantRemoving:Connect(function(descendant)
        local tracked = trackedLocalSkillLabels[descendant]
        if tracked then
            safeDisconnect(tracked.Connection)
            if tracked.ActionImage then
                local originalImage = originalActionImages[tracked.ActionImage]
                if originalImage ~= nil and tracked.ActionImage.Parent then
                    tracked.ActionImage.Image = originalImage
                    originalActionImages[tracked.ActionImage] = nil
                end
            end
            trackedLocalSkillLabels[descendant] = nil
        end
    end))
end

