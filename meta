local function ensureGlobalTable(name, defaults)
    local env = getgenv()
    env[name] = env[name] or {}
    for key, value in pairs(defaults or {}) do
        if env[name][key] == nil then
            env[name][key] = value
        end
    end
    return env[name]
end

