function __VelocityFns.getPlatformSpoofValue()
    local platform = getgenv().Spoof.Platform or "Controller"
    if platform == "Touch/Mobile" then
        platform = "Mobile"
    end

    if getgenv().Spoof.KeyboardOverrideEnabled and getgenv().Spoof.KeyboardOverrideActive then
        return "Keyboard"
    end

    if platform == "Controller"
        and getgenv().Spoof.AutoSwitchToKeyboardWhileTyping
        and not UserInputService.TouchEnabled
        and UserInputService:GetFocusedTextBox() then
        platform = "Keyboard"
    end

    return platform
end

local lastSentPlatform
local lastPlatformRemote
local lastPlatformRemoteAt = -math.huge
local PLATFORM_REMOTE_MIN_GAP = 0.6

-- Keep remote state separate from local HUD/attribute state. The local
-- Platform attribute cannot prove what other players received from server.
function __VelocityFns.syncPlatformRemote(force, observedMismatch)
    local platform = __VelocityFns.getPlatformSpoofValue()
    local remote = ReplicatedStorage:FindFirstChild("Platform")
    local now = os.clock()
    if not remote then return false end
    local needsSend = force == true
        or platform ~= lastSentPlatform
        or remote ~= lastPlatformRemote
        or (observedMismatch and now - lastPlatformRemoteAt >= PLATFORM_REMOTE_MIN_GAP)
    if not needsSend then return false end

    local ok = pcall(function() remote:FireServer(platform) end)
    if ok then
        lastSentPlatform = platform
        lastPlatformRemote = remote
        lastPlatformRemoteAt = now
    end
    return ok
end

function __VelocityFns.applyPlatformSpoof(force)
    local platform = __VelocityFns.getPlatformSpoofValue()
    local observedMismatch = LocalPlayer:GetAttribute("Platform") ~= platform
    if observedMismatch then
        pcall(function() LocalPlayer:SetAttribute("Platform", platform) end)
    end
    __VelocityFns.syncPlatformRemote(force, observedMismatch)
    __VelocityFns.applyCursor()
    if __VelocityFns.consoleGui then
        local visible = platform == "Controller"
        if __VelocityFns.consoleGui.Enabled ~= visible then
            __VelocityFns.consoleGui.Enabled = visible
        end
    end
    if __VelocityFns.refreshModePrompt then
        __VelocityFns.refreshModePrompt()
    end
end

function __VelocityFns.forcePlatformSpoofBurst()
    __VelocityFns.applyPlatformSpoof(true)
end

