function __VelocityFns.updateFovCircle()
    Camera = Workspace.CurrentCamera
    if not FovCircle or not Camera then
        return
    end
    if __VelocityFns.isStreamproof() then
        FovCircle.Visible = false
        return
    end
    if getgenv().AimbotSettings.ShowFov then
        local mousePos = UserInputService:GetMouseLocation()
        FovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        FovCircle.Radius = getgenv().AimbotSettings.FOV
        FovCircle.Visible = true
    else
        FovCircle.Visible = false
    end
end

function __VelocityFns.getDistanceFromCursorToWorldPos(worldPos)
    Camera = Workspace.CurrentCamera
    if not Camera then
        return math.huge
    end
    local vector, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then
        return math.huge
    end
    local mousePos = UserInputService:GetMouseLocation()
    local dx, dy = vector.X - mousePos.X, vector.Y - mousePos.Y
    return dx * dx + dy * dy
end

function __VelocityFns.isValidTarget(character)
    if not character or not character:IsA("Model") then
        return false
    end
    local humanoid = __VelocityFns.getHumanoid(character)
    local bone = __VelocityFns.getTargetPart(character)
    if not (humanoid and bone and humanoid.Health > 0) then
        return false
    end
    if character:FindFirstChild("NoTarg") or character:FindFirstChild("ForceUnlock") then
        return false
    end
    local torso = character:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") and torso.Transparency > 0.991 then
        return false
    end

    local owner = Players:GetPlayerFromCharacter(character)
    if owner and owner == LocalPlayer then
        return false
    end

    if owner then
        if getgenv().AimbotSettings.Team_Check and owner.Team and LocalPlayer.Team and owner.Team == LocalPlayer.Team then
            return false
        end
        return true
    end

    if getgenv().AimbotSettings.Npc then
        return true
    end

    return false
end

function __VelocityFns.getClosestAimbotTarget(excluded)
    local minDist = math.huge
    local bestCharacter = nil
    local fov = math.max(tonumber(getgenv().AimbotSettings.FOV) or 120, 0)
    local fovSquared = fov * fov

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character ~= excluded
            and player.Character and __VelocityFns.isValidTarget(player.Character) then
            local aimPosition = __VelocityFns.getAimbotAimPosition(player.Character)
            if aimPosition then
                local dist = __VelocityFns.getDistanceFromCursorToWorldPos(aimPosition)
                if dist <= fovSquared and dist < minDist then
                    minDist = dist
                    bestCharacter = player.Character
                end
            end
        end
    end

    if getgenv().AimbotSettings.Npc then
        local live = Workspace:FindFirstChild("Live")
        if live then
            for _, npc in ipairs(live:GetChildren()) do
                if npc ~= excluded and not Players:GetPlayerFromCharacter(npc)
                    and __VelocityFns.isValidTarget(npc) then
                    local aimPosition = __VelocityFns.getAimbotAimPosition(npc)
                    if aimPosition then
                        local dist = __VelocityFns.getDistanceFromCursorToWorldPos(aimPosition)
                        if dist <= fovSquared and dist < minDist then
                            minDist = dist
                            bestCharacter = npc
                        end
                    end
                end
            end
        end
    end

    return bestCharacter
end

function __VelocityFns.getDirectionalAimbotTarget(currentTarget, side)
    local camera = Workspace.CurrentCamera
    if not camera or not currentTarget then return nil end
    local currentPart = __VelocityFns.getTargetPart(currentTarget)
    if not currentPart then return nil end
    local currentScreen, visible = camera:WorldToViewportPoint(currentPart.Position)
    if not visible then return nil end
    local best, bestScore
    local maxRadius = math.max(tonumber(getgenv().AimbotSettings.FOV) or 120, 0)
    local function consider(character)
        if character == currentTarget or not __VelocityFns.isValidTarget(character) then return end
        local position = __VelocityFns.getAimbotAimPosition(character)
        if not position then return end
        local point, onScreen = camera:WorldToViewportPoint(position)
        if not onScreen then return end
        local dx = point.X - currentScreen.X
        if dx * side <= 8 then return end
        local cursorDist = __VelocityFns.getDistanceFromCursorToWorldPos(position)
        if cursorDist > maxRadius * maxRadius then return end
        local score = math.abs(dx) + math.abs(point.Y - currentScreen.Y) * 0.5
        if not bestScore or score < bestScore then
            best, bestScore = character, score
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then consider(player.Character) end
    end
    if getgenv().AimbotSettings.Npc then
        local live = Workspace:FindFirstChild("Live")
        if live then
            for _, npc in ipairs(live:GetChildren()) do
                if not Players:GetPlayerFromCharacter(npc) then consider(npc) end
            end
        end
    end
    return best
end

local AimbotRenderStepName = "VelocityAimbotCamera"
local AimbotRenderStepBound = false
local FovDrawConnection = nil
local LockedAimbotTarget = nil
local AimRotationHumanoid
local AimRotationOriginalAutoRotate
local AimbotSelectionBoxTarget
local AimbotSelectionBoxPart

function __VelocityFns.clearAimbotSelectionBoxSafely()
    if AimbotSelectionBox then
        AimbotSelectionBox:Destroy()
        AimbotSelectionBox = nil
    end
    AimbotSelectionBoxTarget = nil
    AimbotSelectionBoxPart = nil
end

function __VelocityFns.updateAimbotSelectionBox(target, targetPart)
    if not Toggles.AimbotSelectionBox.Value or not target then
        __VelocityFns.clearAimbotSelectionBoxSafely()
        return
    end

    if not AimbotSelectionBox then
        local template = game.StarterGui:FindFirstChild("SelectionBox", true)
        if not template then
            return
        end
        AimbotSelectionBox = template:Clone()
    end

    targetPart = targetPart or target
    if AimbotSelectionBoxTarget ~= target
        or AimbotSelectionBoxPart ~= targetPart
        or AimbotSelectionBox.Parent ~= target
        or AimbotSelectionBox.Adornee ~= targetPart
        or not AimbotSelectionBox.Enabled then
        AimbotSelectionBox.Parent = target
        AimbotSelectionBox.Adornee = targetPart
        AimbotSelectionBox.Enabled = true
        AimbotSelectionBoxTarget = target
        AimbotSelectionBoxPart = targetPart
    end
end

function __VelocityFns.restoreAimbotCharacterRotation()
    if AimRotationHumanoid and AimRotationHumanoid.Parent and AimRotationOriginalAutoRotate ~= nil then
        AimRotationHumanoid.AutoRotate = AimRotationOriginalAutoRotate
    end
    AimRotationHumanoid = nil
    AimRotationOriginalAutoRotate = nil
end

function __VelocityFns.alignAimbotCharacter(root, humanoid, targetPosition)
    local settings = getgenv().AimbotSettings
    if not settings.AlignCharacterYaw then
        __VelocityFns.restoreAimbotCharacterRotation()
        return
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
        __VelocityFns.restoreAimbotCharacterRotation()
        return
    end
    if AimRotationHumanoid ~= humanoid then
        __VelocityFns.restoreAimbotCharacterRotation()
        AimRotationHumanoid = humanoid
        AimRotationOriginalAutoRotate = humanoid.AutoRotate
    end
    humanoid.AutoRotate = false
    local flatTarget = Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z)
    if (flatTarget - root.Position).Magnitude > 0.001 then
        root.CFrame = CFrame.lookAt(root.Position, flatTarget)
    end
end

function __VelocityFns.startAimbot()
    if AimbotRenderStepBound then
        RunService:UnbindFromRenderStep(AimbotRenderStepName)
        AimbotRenderStepBound = false
    end

    if FovDrawConnection then
        safeDisconnect(FovDrawConnection)
        FovDrawConnection = nil
    end

    if _G.__AimbotMouseConn then
        safeDisconnect(_G.__AimbotMouseConn)
        _G.__AimbotMouseConn = nil
    end
    if _G.__AimbotMouseConn2 then
        safeDisconnect(_G.__AimbotMouseConn2)
        _G.__AimbotMouseConn2 = nil
    end
    if _G.__VelocityAimFocusConn then
        safeDisconnect(_G.__VelocityAimFocusConn)
        _G.__VelocityAimFocusConn = nil
    end
    if _G.__VelocityAimRespawnConn then
        safeDisconnect(_G.__VelocityAimRespawnConn)
        _G.__VelocityAimRespawnConn = nil
    end
    if _G.__VelocityAimTiltConn then
        safeDisconnect(_G.__VelocityAimTiltConn)
        _G.__VelocityAimTiltConn = nil
    end
    __VelocityFns.restoreAimbotCharacterRotation()
    __VelocityFns.clearAimbotSelectionBoxSafely()
    LockedAimbotTarget = nil

    if not getgenv().AimbotSettings.Enabled then
        LockedAimbotTarget = nil
        if FovCircle then
            FovCircle.Visible = false
        end
        return
    end

    local fovElapsed = 0
    FovDrawConnection = RunService.Heartbeat:Connect(function(dt)
        if not getgenv().AimbotSettings.ShowFov then return end
        fovElapsed += dt
        if fovElapsed >= 0.05 then
            fovElapsed = 0
            __VelocityFns.updateFovCircle()
        end
    end)
    __VelocityFns.updateFovCircle()

    if _G.__AimbotMouseConn then
        safeDisconnect(_G.__AimbotMouseConn)
    end
    if _G.__AimbotMouseConn2 then
        safeDisconnect(_G.__AimbotMouseConn2)
    end

    local cachedBone
    local cachedBoneName
    local lastBonePosition
    local missFrames = 0
    local acquireElapsed = 0
    local appliedCameraHeight = 0
    local maxMissFrames = 12
    local toggleAimActive = false
    local controllerAimActive = false
    local function resetAimInput()
        toggleAimActive = false
        controllerAimActive = false
        LockedAimbotTarget = nil
        cachedBone = nil
        cachedBoneName = nil
        lastBonePosition = nil
        missFrames = 0
        acquireElapsed = 0
        __VelocityFns.clearAimbotSelectionBoxSafely()
        __VelocityFns.restoreAimbotCharacterRotation()
    end

    _G.__AimbotMouseConn = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe and not (input.KeyCode == Enum.KeyCode.ButtonR3
            and getgenv().AimbotSettings.ControllerR3Lock
            and not UserInputService:GetFocusedTextBox()) then return end
        if input.KeyCode == Enum.KeyCode.ButtonR3 and getgenv().AimbotSettings.ControllerR3Lock then
            controllerAimActive = not controllerAimActive
            if controllerAimActive then
                LockedAimbotTarget = __VelocityFns.getClosestAimbotTarget()
                cachedBone, cachedBoneName, lastBonePosition = nil, nil, nil
                missFrames, acquireElapsed = 0, 0
            elseif not toggleAimActive
                and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                resetAimInput()
            end
            return
        end
        local directionalSide = input.KeyCode == Enum.KeyCode.Y and -1
            or (input.KeyCode == Enum.KeyCode.U and 1 or nil)
        if directionalSide and getgenv().AimbotSettings.DirectionalSwitch then
            local isToggle = getgenv().AimbotSettings.InputMode == "Toggle"
            local active = controllerAimActive or (isToggle and toggleAimActive or
                (not isToggle and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)))
            if active and LockedAimbotTarget then
                local candidate = __VelocityFns.getDirectionalAimbotTarget(LockedAimbotTarget, directionalSide)
                if candidate then
                    LockedAimbotTarget = candidate
                    cachedBone = nil
                    cachedBoneName = nil
                    lastBonePosition = nil
                    missFrames = 0
                    acquireElapsed = 0
                end
            end
            return
        end
        if input.KeyCode == Enum.KeyCode.T and getgenv().AimbotSettings.CycleTarget then
            local isToggle = getgenv().AimbotSettings.InputMode == "Toggle"
            local active = controllerAimActive or (isToggle and toggleAimActive or
                (not isToggle and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)))
            if active and LockedAimbotTarget then
                local candidate = __VelocityFns.getClosestAimbotTarget(LockedAimbotTarget)
                if candidate then
                    LockedAimbotTarget = candidate
                    cachedBone = nil
                    cachedBoneName = nil
                    lastBonePosition = nil
                    missFrames = 0
                    acquireElapsed = 0
                end
            end
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
        if getgenv().AimbotSettings.InputMode == "Toggle" then
            toggleAimActive = not toggleAimActive
            if not toggleAimActive then
                if not controllerAimActive then resetAimInput() end
                return
            end
        end
        LockedAimbotTarget = __VelocityFns.getClosestAimbotTarget()
        cachedBone = nil
        cachedBoneName = nil
        lastBonePosition = nil
        missFrames = 0
        acquireElapsed = 0
    end)

    _G.__AimbotMouseConn2 = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2
            and getgenv().AimbotSettings.InputMode ~= "Toggle"
            and not controllerAimActive then
            resetAimInput()
        end
    end)

    if _G.__VelocityAimFocusConn then safeDisconnect(_G.__VelocityAimFocusConn) end
    if _G.__VelocityAimRespawnConn then safeDisconnect(_G.__VelocityAimRespawnConn) end
    _G.__VelocityAimFocusConn = UserInputService.WindowFocusReleased:Connect(resetAimInput)
    _G.__VelocityAimRespawnConn = LocalPlayer.CharacterAdded:Connect(resetAimInput)

    RunService:BindToRenderStep(AimbotRenderStepName, Enum.RenderPriority.Camera.Value + 8, function(dt)
        if not getgenv().AimbotSettings.Enabled then
            return
        end

        Camera = Workspace.CurrentCamera
        if not Camera then return end
        local cameraCFrame = Camera and Camera.CFrame
        local cameraFocus = Camera and Camera.Focus
        local aimTargetPosition
        local aimBlend
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local aiming
        if getgenv().AimbotSettings.InputMode == "Toggle" then
            aiming = toggleAimActive or controllerAimActive
        else
            aiming = controllerAimActive or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        end

        local settings = getgenv().AimbotSettings
        if aiming then
            local target = LockedAimbotTarget
            if not target then
                acquireElapsed += dt
                if acquireElapsed >= 0.1 then
                    acquireElapsed = 0
                    target = __VelocityFns.getClosestAimbotTarget()
                    LockedAimbotTarget = target
                    cachedBone = nil
                    cachedBoneName = nil
                    lastBonePosition = nil
                    missFrames = 0
                end
            else
                acquireElapsed = 0
            end

            if target then
                local boneName = getgenv().AimbotSettings.Bone or "HumanoidRootPart"
                if cachedBoneName ~= boneName or not cachedBone or cachedBone.Parent ~= target then
                    cachedBone = __VelocityFns.getTargetPart(target)
                    cachedBoneName = boneName
                end

                local targetHumanoid = __VelocityFns.getHumanoid(target)
                local targetAlive = target.Parent ~= nil
                    and targetHumanoid ~= nil
                    and targetHumanoid.Health > 0
                    and not target:FindFirstChild("ForceUnlock")
                    and not target:FindFirstChild("NoTarg")
                if targetAlive then
                    missFrames = 0
                else
                    missFrames += 1
                end

                if missFrames >= maxMissFrames then
                    LockedAimbotTarget = nil
                    cachedBone = nil
                    cachedBoneName = nil
                    lastBonePosition = nil
                    missFrames = 0
                    __VelocityFns.clearAimbotSelectionBoxSafely()
                    __VelocityFns.restoreAimbotCharacterRotation()
                    target = nil
                end

                if target then
                    local targetPosition
                    if cachedBone and cachedBone.Parent == target then
                        targetPosition = cachedBone.Position
                        lastBonePosition = targetPosition
                        __VelocityFns.updateAimbotSelectionBox(target, cachedBone)
                    elseif lastBonePosition then
                        targetPosition = lastBonePosition
                    end

                    if targetPosition then
                        aimTargetPosition = __VelocityFns.getAimPositionFromPosition(targetPosition)

                        aimBlend = true
                    else
                        __VelocityFns.clearAimbotSelectionBoxSafely()
                        __VelocityFns.restoreAimbotCharacterRotation()
                    end
                end
            else
                __VelocityFns.clearAimbotSelectionBoxSafely()
                __VelocityFns.restoreAimbotCharacterRotation()
            end
        else
            if LockedAimbotTarget then
                LockedAimbotTarget = nil
                cachedBone = nil
                cachedBoneName = nil
                lastBonePosition = nil
                missFrames = 0
                acquireElapsed = 0
                __VelocityFns.clearAimbotSelectionBoxSafely()
                __VelocityFns.restoreAimbotCharacterRotation()
            end
        end

        if aiming and aimTargetPosition and root and humanoid and humanoid.Health > 0 and not Attached then
            __VelocityFns.alignAimbotCharacter(root, humanoid, aimTargetPosition)
        else
            __VelocityFns.restoreAimbotCharacterRotation()
        end

        local cameraHeightTarget = 0

        if aiming and aimTargetPosition then
            cameraHeightTarget = math.clamp(
                tonumber(getgenv().AimbotSettings.CameraHeightOffset) or 0,
                -2, 4
            )
        end

        if Camera and cameraCFrame and aiming and aimTargetPosition then

            if Camera.CameraType == Enum.CameraType.Scriptable then
                appliedCameraHeight = 0
                return
            end

           appliedCameraHeight = cameraHeightTarget

            if cameraHeightTarget == 0
                and math.abs(appliedCameraHeight) < 0.005 then
                appliedCameraHeight = 0
            end

            local cameraTranslation = Vector3.new(
                0,
                appliedCameraHeight,
                0
            )

            local cameraPosition =
                cameraCFrame.Position + cameraTranslation

            local cameraRotation = cameraCFrame.Rotation

            if aimTargetPosition and aimBlend then
                local direction = aimTargetPosition - cameraPosition
                if direction.Magnitude > 0.01 then
                    local horizontalDirection = Vector3.new(direction.X, 0, direction.Z)
                    local horizontalDistance = horizontalDirection.Magnitude
                    local cameraForward = cameraRotation.LookVector
                    local flatForward = Vector3.new(cameraForward.X, 0, cameraForward.Z)
                    if flatForward.Magnitude < 0.001 then
                        flatForward = Vector3.new(0, 0, -1)
                    end
                    local stableHorizontal = flatForward.Unit
                    if horizontalDistance > 0.05 then
                        local headingWeight = clamp((horizontalDistance - 1.0) / 2.0, 0, 1)
                        local heading = stableHorizontal * (1 - headingWeight)
                            + horizontalDirection.Unit * headingWeight
                        if heading.Magnitude > 0.001 then
                            stableHorizontal = heading.Unit
                        end
                    end

                    local nativePitch = math.asin(clamp(cameraForward.Y, -1, 1))
                    local desiredPitch = math.atan2(direction.Y, math.max(horizontalDistance, 3.5))
                    local pitchWeight = clamp((horizontalDistance - 1.0) / 5.0, 0, 1)
                    local pitch = nativePitch + (desiredPitch - nativePitch) * pitchWeight
                    if settings.ViewStyle == "Overhead" then
                        local overhead = math.rad(clamp(tonumber(settings.OverheadPitch) or 10, 0, 20))
                        pitch = clamp(pitch - overhead, math.rad(-70), math.rad(60))
                    end
                    local correctedDirection = stableHorizontal * math.cos(pitch)
                        + Vector3.yAxis * math.sin(pitch)
                    local targetRotation = CFrame.lookAt(
                        cameraPosition, cameraPosition + correctedDirection
                    ).Rotation

                    local strength = clamp(tonumber(settings.AdaptiveResponse) or 8.5, 0.1, 1)
                    local blocking = character and character:FindFirstChild("Blocking")
                    if blocking and blocking:IsA("BoolValue") and blocking.Value then
                        strength -= 0.5
                    end
                    if cachedBone and cachedBone:IsA("BasePart") then
                        local velocity = cachedBone.AssemblyLinearVelocity
                        local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                        if horizontalSpeed > 25 or
                            (LockedAimbotTarget and LockedAimbotTarget:FindFirstChild("Dodging")) then
                            strength -= 0.2
                        end
                        if root and cachedBone.Position.Y > root.Position.Y + 20 then
                            strength -= 0.2
                        end
                    end
                    local frameAlpha = clamp(strength, 0.05, 1)
                    local alpha = 1 - math.pow(1 - frameAlpha, math.max(dt, 0) * 110)
                    cameraRotation = cameraRotation:Lerp(targetRotation, clamp(alpha, 0, 1))
                end
            end

            Camera.CFrame = CFrame.new(cameraPosition) * cameraRotation
        end
    end)
    AimbotRenderStepBound = true
end

local parryRunning = false
local parryPending = false
-- Invalidate outstanding reaction tasks on toggle-off, respawn, or unload.
-- An old task must not reset the state of a newer reaction.
local parryEpoch = 0
local parrySequenceSerial = 0
local healthConnection = nil
local inputRemote = nil
local inputChildConnection = nil
local inputRemovedConnection = nil
local backpackChildConnection = nil
local backpackRemovedConnection = nil
local autoParryCharacterConnection = nil

function __VelocityFns.refreshInputRemote()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    local remote = (backpack and backpack:FindFirstChild("Input")) or (character and character:FindFirstChild("Input"))
    if remote and remote:IsA("RemoteEvent") then
        inputRemote = remote
    else
        inputRemote = nil
    end
    return inputRemote ~= nil
end

function __VelocityFns.watchInputRemote(character)
    if inputChildConnection then
        safeDisconnect(inputChildConnection)
        inputChildConnection = nil
    end
    if inputRemovedConnection then
        safeDisconnect(inputRemovedConnection)
        inputRemovedConnection = nil
    end
    if backpackChildConnection then
        safeDisconnect(backpackChildConnection)
        backpackChildConnection = nil
    end
    if backpackRemovedConnection then
        safeDisconnect(backpackRemovedConnection)
        backpackRemovedConnection = nil
    end

    if character then
        inputChildConnection = character.ChildAdded:Connect(function(child)
            if child.Name == "Input" then
                __VelocityFns.refreshInputRemote()
            end
        end)
        inputRemovedConnection = character.ChildRemoved:Connect(function(child)
            if child == inputRemote then
                __VelocityFns.refreshInputRemote()
            end
        end)
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        backpackChildConnection = backpack.ChildAdded:Connect(function(child)
            if child.Name == "Input" then
                __VelocityFns.refreshInputRemote()
            end
        end)
        backpackRemovedConnection = backpack.ChildRemoved:Connect(function(child)
            if child == inputRemote then
                __VelocityFns.refreshInputRemote()
            end
        end)
    end

    __VelocityFns.refreshInputRemote()
end

function __VelocityFns.getParryTarget()
    local character = LocalPlayer.Character
    local config = getgenv().AutoParry
    local range = math.max(tonumber(config and config.Range) or 25, 0)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local closest, minDistSq = nil, range * range
    local myPos = hrp.Position
    local seen = {}
    local targetType = config.TargetType or "Both"

    local function consider(model)
        if not model or model == character or not model:IsA("Model") or seen[model] then return end
        seen[model] = true
        local player = Players:GetPlayerFromCharacter(model)
        if targetType == "Players" and not player then return end
        if targetType == "NPCs" and player then return end
        if config.IgnoreTeammates and player and player.Team and LocalPlayer.Team
            and player.Team == LocalPlayer.Team then return end

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return end
        local delta = root.Position - myPos
        local distSq = delta:Dot(delta)
        if distSq <= minDistSq then
            minDistSq, closest = distSq, root
        end
    end

    if targetType ~= "NPCs" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then consider(player.Character) end
        end
    end

    if targetType ~= "Players" then
        local live = Workspace:FindFirstChild("Live")
        if live then
            for _, model in ipairs(live:GetChildren()) do consider(model) end
        end
    elseif Workspace:FindFirstChild("Live") then

        for _, model in ipairs(LiveFolder:GetChildren()) do
            if Players:GetPlayerFromCharacter(model) then consider(model) end
        end
    end
    return closest
end

function __VelocityFns.canAutoParry()
    local config = getgenv().AutoParry
    return config and config.Enabled
end

function __VelocityFns.fireInput(...)
    if not inputRemote or not inputRemote.Parent then
        __VelocityFns.refreshInputRemote()
    end
    if not inputRemote then
        return false
    end

    local args = { ... }
    local remote = inputRemote
    local success = pcall(function()
        remote:FireServer(table.unpack(args))
    end)
    if not success then
        __VelocityFns.refreshInputRemote()
        remote = inputRemote
        if remote then
            success = pcall(function()
                remote:FireServer(table.unpack(args))
            end)
        end
    end
    return success
end

-- Diagnostic counters are reset at script launch. They distinguish multiple parry
-- reactions from a single M1 request that the game may interpret as ongoing.
-- V6 Auto Parry: independent damage and confirmed local block-impact signals.
-- These signals are only heuristics. No available client event proves a server
-- accepted a perfect parry; false/missing cues remain possible.
local AutoParryDebug = {
    DamageEvents = 0,
    ImpactCuesSeen = 0,
    ImpactReactions = 0,
    AcceptedReactions = 0,
    RejectedCooldown = 0,
    M1Requests = 0,
    M1Failed = 0,
    ControllerSkipped = 0,
    LastInputMethod = "none",
    LastDamage = 0,
    LastAcceptedAt = 0,
    LastTriggerSource = "none",
    LastCueName = "none",
    RecentGuardSounds = {},
}
getgenv().AutoParryDiagnostics = AutoParryDebug

-- Disconnect all previous character's block-signal listeners on respawn.
local parryImpactConnections = {}
local function clearParryImpactConnections()
    for _, connection in ipairs(parryImpactConnections) do
        safeDisconnect(connection)
    end
    table.clear(parryImpactConnections)
end

function __VelocityFns.cancelAutoParryReaction(restoreGuard)
    parryEpoch += 1
    parrySequenceSerial += 1
    local interrupted = parryRunning
    parryRunning = false
    parryPending = false
    if restoreGuard and interrupted and LocalPlayer.Character then
        __VelocityFns.fireInput(__VelocityFns.isAutoParryJumpHeld() and "SpaceOn" or "SpaceOff")
        __VelocityFns.fireInput(__VelocityFns.isAutoParryGuardHeld() and "BlockOn" or "BlockOff")
    end
end

function __VelocityFns.parrySequence(forceTarget)
    if parryRunning then return end
    parryRunning = true
    parrySequenceSerial += 1
    local serial = parrySequenceSerial
    local epoch = parryEpoch
    local character = LocalPlayer.Character
    local function active()
        return epoch == parryEpoch
            and serial == parrySequenceSerial
            and character == LocalPlayer.Character
            and getgenv().AutoParry.Enabled == true
    end
    local ok = pcall(function()
        local config = getgenv().AutoParry
        if not active() or not character or not __VelocityFns.refreshInputRemote() then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        if config.RequireBlockHeld and not __VelocityFns.isAutoParryGuardHeld() then return end

        local released = __VelocityFns.fireInput("BlockOff")
        if not released then return end
        task.wait(math.clamp(tonumber(config.ReleaseDelay) or 0.015, 0.005, 0.1))
        if not active() or humanoid.Health <= 0 then return end

        local state = humanoid:GetState()
        local airborne = state == Enum.HumanoidStateType.Jumping
            or state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.FallingDown
        local heldSpace = __VelocityFns.isAutoParryJumpHeld()
        local airAttack = airborne and heldSpace and config.SpacePolicy ~= "Downslam"
        __VelocityFns.fireInput(airAttack and "SpaceOn" or "SpaceOff")

        local followUp = config.FollowUp or "M1"
        local useM1 = followUp == "M1"
            or followUp == "Grounded M1" and not airborne and not heldSpace
        if useM1 and active() then
            local usesGamepad = false
            if config.UseControllerSupport == true then
                local padsOk, pads = pcall(function()
                    return UserInputService:GetConnectedGamepads()
                end)
                usesGamepad = padsOk and pads ~= nil and #pads > 0
            end
            local mode = config.ControllerFollowUpMode or "Remote M1"
            if usesGamepad and mode == "Guard Only (diagnostic)" then
                AutoParryDebug.ControllerSkipped += 1
                AutoParryDebug.LastInputMethod = "Controller guard only"
            else
                local target = forceTarget
                if not target or not target:IsDescendantOf(Workspace) then
                    target = __VelocityFns.getParryTarget()
                end
                local root = character:FindFirstChild("HumanoidRootPart")
                local hitCFrame = target and target.CFrame or root and root.CFrame or CFrame.new()
                local requestOk = __VelocityFns.fireInput("M1", {
                    air = airAttack,
                    skeyreal = false,
                    skeydown = true,
                    mousehit = hitCFrame,
                    md = Vector3.zero,
                })
                AutoParryDebug.M1Requests += 1
                if not requestOk then AutoParryDebug.M1Failed += 1 end
                AutoParryDebug.LastInputMethod = usesGamepad
                    and "Controller remote M1" or "KBM remote M1"
            end
        end
        task.wait(math.clamp(tonumber(config.RecoveryDelay) or 0.05, 0.01, 0.2))
    end)
    -- Restore the real held input state even when the M1 request errors or
    -- there was no valid follow-up. Do not restore on a newer character.
    if serial == parrySequenceSerial then
        if character and character == LocalPlayer.Character then
            __VelocityFns.fireInput(__VelocityFns.isAutoParryJumpHeld() and "SpaceOn" or "SpaceOff")
            __VelocityFns.fireInput(__VelocityFns.isAutoParryGuardHeld() and "BlockOn" or "BlockOff")
        end
        parryRunning = false
    end
    if not ok and serial == parrySequenceSerial then
        __VelocityFns.refreshInputRemote()
    end
end

local lastParryTrigger = -math.huge
local function isBlockImpactName(name)
    if type(name) ~= "string" then return false end
    local token = name:lower():gsub("[^a-z0-9]", "")
    -- Exact names intentionally exclude ordinary 'Blocking'/'BlockOn',
    -- which would otherwise spam counters just from holding guard.
    if token == "guardbreak" or token == "blockbreak"
        or token == "blockon" or token == "blockoff"
        or token == "blocking" or token == "blockstart"
        or token == "guardstart" or token == "guardon" then
        return false
    end
    if token == "perfectblock" or token == "perfectguard"
        or token == "perfectparry" or token == "parryimpact"
        or token == "parrysuccess" then return true end
    local guardWord = token:find("block", 1, true)
        or token:find("guard", 1, true)
        or token:find("shield", 1, true)
    return guardWord ~= nil and (
        token:find("hit", 1, true) ~= nil
        or token:find("impact", 1, true) ~= nil
        or token:find("contact", 1, true) ~= nil
    )
end

-- One entry point for reactions. Suppresses duplicate damage + visual/sound
-- events produced by the same impact and respects toggle/respawn cancellation.
function __VelocityFns.requestAutoParryReaction(source, damage, forcedTarget, cueName)
    local character = LocalPlayer.Character
    local config = getgenv().AutoParry
    if not character or not config or not config.Enabled then return false end
    if source == "BlockImpact" and config.BlockImpactCues == false then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if config.RequireBlockHeld and not __VelocityFns.isAutoParryGuardHeld() then return false end

    if config.GroundOnly then
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then
            return false
        end
    end
    if source == "Damage" then
        local minD = tonumber(config.MinDMG) or 0
        local maxD = tonumber(config.MaxDMG) or math.huge
        if minD > maxD or damage < minD or damage > maxD then return false end
    end
    if parryRunning or parryPending then return false end
    local now = os.clock()
    local cooldown = math.max(tonumber(config.TriggerCooldown) or 0.18, 0.05)
    if now - lastParryTrigger < cooldown then
        AutoParryDebug.RejectedCooldown += 1
        return false
    end

    local target = forcedTarget
    if not target or not target:IsDescendantOf(Workspace) then
        -- Block-impact cues should not counter toward nothing. Health damage
        -- keeps the original optional proximity behavior.
        if source == "BlockImpact" or config.RequireNearbyTarget then
            target = __VelocityFns.getParryTarget()
            if not target then return false end
        end
    end
    lastParryTrigger = now
    AutoParryDebug.AcceptedReactions += 1
    AutoParryDebug.LastAcceptedAt = now
    AutoParryDebug.LastTriggerSource = source
    if cueName then AutoParryDebug.LastCueName = cueName end
    if source == "BlockImpact" then AutoParryDebug.ImpactReactions += 1 end

    parryPending = true
    local queuedEpoch = parryEpoch
    task.spawn(function()
        if queuedEpoch ~= parryEpoch or character ~= LocalPlayer.Character
            or getgenv().AutoParry.Enabled ~= true then
            return
        end
        parryPending = false
        __VelocityFns.parrySequence(target)
    end)
    return true
end

function __VelocityFns.setupAutoParryCharacter(character)
    __VelocityFns.cancelAutoParryReaction(false)
    clearParryImpactConnections()
    if healthConnection then
        safeDisconnect(healthConnection)
        healthConnection = nil
    end
    if character ~= LocalPlayer.Character then return end
    local humanoid = character:WaitForChild("Humanoid", 4)
    if not humanoid or character ~= LocalPlayer.Character then return end

    lastParryTrigger = -math.huge
    local lastHealth = humanoid.Health
    healthConnection = humanoid.HealthChanged:Connect(function(newHealth)
        if character ~= LocalPlayer.Character then return end
        local damage = lastHealth - newHealth
        lastHealth = newHealth
        if damage > 0 then
            AutoParryDebug.DamageEvents += 1
            AutoParryDebug.LastDamage = damage
        end
        if damage <= 0 or newHealth <= 0 or humanoid.Health <= 0 then return end
        __VelocityFns.requestAutoParryReaction("Damage", damage)
    end)

    local seenSounds = {}
    local lastCueAt = setmetatable({}, { __mode = "k" })
    local function emitImpactCue(instance, cueName)
        local now = os.clock()
        if now - (lastCueAt[instance] or -math.huge) < 0.09 then return end
        lastCueAt[instance] = now
        AutoParryDebug.ImpactCuesSeen += 1
        __VelocityFns.requestAutoParryReaction("BlockImpact", 0, nil, cueName)
    end
    local function recordGuardSound(name)
        if not __VelocityFns.isAutoParryGuardHeld() then return end
        local recent = AutoParryDebug.RecentGuardSounds
        -- Keep a bounded trace of sound names while physically holding guard.
        -- This is diagnostic only and does not trigger unverified animations.
        recent[#recent + 1] = name
        if #recent > 12 then table.remove(recent, 1) end
    end
    local function attachImpactCue(instance, justAdded)
        if not instance then return end
        local matchesImpact = isBlockImpactName(instance.Name)
        if instance:IsA("Sound") then
            if seenSounds[instance] then return end
            seenSounds[instance] = true
            local sound = instance
            table.insert(parryImpactConnections, sound.Played:Connect(function()
                if character ~= LocalPlayer.Character then return end
                recordGuardSound(sound.Name)
                if matchesImpact then
                    emitImpactCue(sound, sound.Name)
                end
            end))
            -- Sound.Played may be missed when the Sound is inserted already
            -- running. This queued check captures that exact race.
            if justAdded then
                task.defer(function()
                    if character == LocalPlayer.Character and sound.Parent and sound.IsPlaying then
                        recordGuardSound(sound.Name)
                        if matchesImpact then
                            emitImpactCue(sound, sound.Name)
                        end
                    end
                end)
            end
        elseif justAdded and matchesImpact then
            -- Ephemeral combat marker/effect under the local character.
            emitImpactCue(instance, instance.Name)
        end
    end

    for _, child in ipairs(character:GetDescendants()) do
        attachImpactCue(child, false)
    end
    table.insert(parryImpactConnections, character.DescendantAdded:Connect(function(child)
        attachImpactCue(child, true)
    end))
end

function __VelocityFns.setupAutoParry(character)
    character = character or LocalPlayer.Character
    __VelocityFns.watchInputRemote(character)
    if character then
        __VelocityFns.setupAutoParryCharacter(character)
    end
end

autoParryCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
    __VelocityFns.setupAutoParry(character)
    task.defer(function()
        if LocalPlayer.Character == character then
            __VelocityFns.refreshInputRemote()
        end
    end)
end)

if LocalPlayer.Character then
