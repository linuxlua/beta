    if getgenv().Cursor.Position == "Centered" then
        consoleDot.Position = UDim2.fromScale(0.5, 0.5)
    else
        local point = UserInputService:GetMouseLocation()
        consoleDot.Position = UDim2.fromOffset(point.X, point.Y)
    end
end

