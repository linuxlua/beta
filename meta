local function migrateUwuConfigs()
    if not (isfolder and isfile and readfile and writefile and listfiles) then return end
    local dest = "uwu/ABA/settings/"
    local sources = { "Velocity/ABA/settings", "stuffnstuff/ABA/settings" }
    for _, old in ipairs(sources) do
        local ok, paths = pcall(function() return isfolder(old) and listfiles(old) or {} end)
        if ok and type(paths) == "table" then
            for i = 1, math.min(#paths, 100) do
                local source = paths[i]
                if type(source) == "string" then
                    local filename = source:match("([^/\\]+)$")
                    if filename and (filename:sub(-5):lower() == ".json" or filename == "autoload.txt") then
                        local target = dest .. filename
                        pcall(function()
                            if not isfile(target) then writefile(target, readfile(source)) end
                        end)
                    end
                end
            end
        end
    end
end
