local MacroInputConnection = UserInputService.InputBegan:Connect(function(input, gp)
    if gp or UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType.Name:match("^Gamepad") then
        if #UserInputService:GetConnectedGamepads() == 0 then return end
        local macro = getgenv().Macro
        local function run(cfg, hot, fn, enabledField, buttonField)
            if hot and isMacroControllerBinding(cfg, input, enabledField, buttonField) then
                task.spawn(fn)
                return true
            end
            return false
        end
        -- Ordered routing: shared button assignments cannot activate several macros.
        if run(macro.InfinityBlue, macro.InfinityBlue.Enabled, __VelocityFns.macroInfinityBlue) then return end
        if run(macro.Gojo, macro.Gojo.TripleBlue, __VelocityFns.macroGojoTripleBlue) then return end
        if run(macro.Mob, macro.Mob.Barrage, __VelocityFns.macroMobBarrage,
            "UseControllerSupportBarrage", "ControllerButtonBarrage") then return end
        if run(macro.Mob, macro.Mob.WeakRepel, __VelocityFns.macroMobWeakRepel,
            "UseControllerSupportWeakRepel", "ControllerButtonWeakRepel") then return end
        if run(macro.Vegeta, macro.Vegeta.Evasive, __VelocityFns.macroVegetaEvasive) then return end
        if run(macro.Zabuza, macro.Zabuza.Clone, __VelocityFns.macroZabuzaCloneHeadride) then return end
        if run(macro.Rikka, macro.Rikka.Uptilt, __VelocityFns.macroRikkaUptilt) then return end
        if run(macro.Stark, macro.Stark.Uptilt, __VelocityFns.macroStarkUptilt) then return end
        if run(macro.Kiri, macro.Kiri.Knife, __VelocityFns.macroKiriKnife) then return end
        if run(macro.Dio, macro.Dio.Uptilt, __VelocityFns.macroDioUptilt) then return end
        if run(macro.Ryoko, macro.Ryoko.Enabled, __VelocityFns.macroRyokoLaunch) then return end
        if run(macro.ForceUptilt, macro.ForceUptilt.Enabled, __VelocityFns.macroForceUptilt) then return end
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local function keyboardMacroMatch(cfg, configuredKey)
        return not cfg.UseControllerSupport and input.KeyCode == configuredKey
    end


