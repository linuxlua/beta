-- Nanami Black Flash: port of the user's older NanamiCheck.OnClientInvoke handler.
-- Uses the old timing-counter logic, not simulated mouse input or metamethod hooks.
local NanamiDiagnostics = { Attempts = 0, LastMethod = "Old source OnClientInvoke", LastError = "", GuiFound = false }
getgenv().NanamiDiagnostics = NanamiDiagnostics
local NanamiInput = Services.UserInputService
local NanamiTween = game:GetService("TweenService")
local NanamiDebris = game:GetService("Debris")
local NanamiLive = workspace:FindFirstChild("Live")
local nanamiRemote = ReplicatedStorage:FindFirstChild("NanamiCheck")
local nanamiGuiTemplate = ReplicatedStorage:FindFirstChild("NanamiCutGUI")

if nanamiRemote and nanamiRemote:IsA("RemoteFunction") and nanamiGuiTemplate then
    nanamiRemote.OnClientInvoke = function(Target, TimeDur, User)
        NanamiDiagnostics.Attempts += 1
        local config = getgenv().BlackFlash or {}
        local root = NanamiLive and Target and NanamiLive:FindFirstChild(Target.Name)
        root = root and root:FindFirstChild("HumanoidRootPart")
        if not root or not User or type(TimeDur) ~= "number" or TimeDur <= 0 then
            NanamiDiagnostics.LastError = "Missing target, user, or timing duration"
            return false, nil, true
        end
        local tempGui = nanamiGuiTemplate:Clone()
        local mainBar = tempGui:FindFirstChild("MainBar")
        local cutter = mainBar and mainBar:FindFirstChild("Cutter")
        if not mainBar or not cutter then
            NanamiDiagnostics.LastError = "Nanami GUI structure changed"
            tempGui:Destroy()
            return false, nil, true
        end
        NanamiDiagnostics.GuiFound = true
        mainBar.Rotation = -80
        tempGui.Parent = root
        tempGui.Adornee = root
        local pressed, inWindow, success = false, false, false
        local inputConnection = NanamiInput.InputBegan:Connect(function(input)
            if pressed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonB then
                if inWindow then success = true else pressed = true end
            end
        end)
        local counter = 0.005
        while counter < 1 and User:GetAttribute("NANAMIAIM") and not (success or pressed) do
            local elapsed = task.wait()
            local division = elapsed / TimeDur
            local difference = math.abs(0.7 - counter)
            if counter < 0.7 then
                mainBar.Rotation = counter / 0.7 * 80 - 80
            else
                mainBar.Rotation = 0
            end
            if difference < 0.025 then division /= 8
            elseif difference < 0.05 then division /= 4 end
            counter += division
            cutter.Position = UDim2.fromScale(counter, 0.5)
            inWindow = difference < 0.02
            if inWindow and config.Nanami then
                local chance = math.clamp(tonumber(config.Nanami_Hitchance) or 100, 0, 100)
                if math.random(1, 100) <= chance then success = true end
            end
        end
        inputConnection:Disconnect()
        if success and User:GetAttribute("NANAMIAIM") then
            cutter.Position = UDim2.fromScale(0.7, 0.5)
            NanamiTween:Create(tempGui, TweenInfo.new(0.25), {Size = UDim2.new(10, 200, 10, 200)}):Play()
            cutter.Size = UDim2.fromScale(0.016, 12)
            NanamiTween:Create(cutter, TweenInfo.new(0.5, Enum.EasingStyle.Linear), {
                Size = UDim2.fromScale(0, 24),
                BackgroundColor3 = Color3.new(1, 0, 0),
                BackgroundTransparency = 1
            }):Play()
            local effect = Instance.new("ColorCorrectionEffect")
            effect.TintColor = Color3.new(0, 0, 0)
            effect.Parent = game:GetService("Lighting")
            NanamiDebris:AddItem(effect, 0.15)
        end
        NanamiDebris:AddItem(tempGui, 0.5)
        NanamiDiagnostics.LastMethod = "Old source OnClientInvoke"
        return success, nil, true
    end
else
    NanamiDiagnostics.LastError = "NanamiCheck or NanamiCutGUI missing"
end

