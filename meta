-- Periodic *server* refresh, without calling applyCursor() or changing
-- the camera/input/UI state. Keeps this separate from Auto Parry and macros.
task.spawn(function()
    while platformResyncActive do
        task.wait(4.0)
        if platformResyncActive then
            __VelocityFns.syncPlatformRemote(true, false)
        end
    end
end)
